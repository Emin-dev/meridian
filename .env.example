# Copy to .env.local. Empty values preserve the public, no-database demo.
# Never put real credentials in source control.

# Set BOTH for a database-backed installation.
DATABASE_URL=""
# Generate a unique signing secret locally: openssl rand -base64 32
AUTH_SECRET=""

# Optional. The only public demo is one WITHOUT DATABASE_URL.
# AUTH_ENABLED=false with a database is rejected, even if a secret is set.
# AUTH_ENABLED="false"

# Optional AI integration. Configure a model available to your provider account.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL_FLASH="deepseek-v4-flash"
